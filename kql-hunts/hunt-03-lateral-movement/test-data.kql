    datetime(2024-01-14 12:31:00), "WORKSTATION03", 445, "10.0.0.51", "\\\\10.0.0.51\\C$", "ConnectionSuccess", "cmd.exe", "attacker",
    datetime(2024-01-14 12:32:00), "WORKSTATION03", 445, "10.0.0.52", "\\\\10.0.0.52\\ADMIN$", "ConnectionSuccess", "cmd.exe", "attacker"
];

